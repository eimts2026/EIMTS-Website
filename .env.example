NEXT_PUBLIC_SITE_URL=https://emeraldislemanpower.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Application email delivery (SMTP mailbox that sends candidate applications)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your@gmail.com,
# SMTP_PASSWORD=a 16-character App Password (Google Account > Security >
# 2-Step Verification > App Passwords — regular passwords do not work).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated recruitment inboxes that receive applications with the CV
APPLICATIONS_EMAIL_TO=
# Optional friendly sender, e.g. "Emerald Isle Website <no-reply@emeraldisle.lk>"
APPLICATIONS_EMAIL_FROM=

# Spam protection: create a Managed widget in Cloudflare Turnstile.
# Public key must be present at build time. Never expose the secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=emeraldislemanpower.com,www.emeraldislemanpower.com

# Server-only Supabase secret key, for rate limits and inquiry delivery.
# A legacy SUPABASE_SERVICE_ROLE_KEY is also supported. NEVER use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Same random secret on website and dashboard, used after job changes.
PUBLIC_CACHE_REVALIDATION_SECRET=
# Log cache reads as well as fills for hit-ratio/age monitoring (optional).
PERFORMANCE_LOGS=0

# Protects the inquiry delivery worker. Schedule it at least once per minute.
# See docs/performance-implementation-report.md before enabling public forms.
CRON_SECRET=
